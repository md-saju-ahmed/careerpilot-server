# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/careerpilot

# Client (must match the Better Auth base URL — used to fetch the JWKS
# endpoint at ${CLIENT_URL}/api/auth/jwks for verifying Bearer tokens)
CLIENT_URL=http://localhost:3000

# Gemini API key
GEMINI_API_KEY=
